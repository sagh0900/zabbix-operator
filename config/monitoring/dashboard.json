      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "zabbix_operator_database_ready{namespace=~\"$namespace\"}",
          "legendFormat": "{{namespace}}/{{database}}",
          "refId": "A",
          "instant": true,
          "range": false
